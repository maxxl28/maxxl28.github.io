---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<Layout title="Maximilian Liu">
  <div class="page">

    <nav>
      <a href="#about">About</a>
      <a href="#experience">Experience</a>
      <a href="#projects">Projects</a>
      <a href="#blog">Blog</a>
    </nav>

    <!-- ABOUT -->
    <section id="about">
      <h1>Maximilian Liu</h1>
      <p class="tagline">CS & Math at Dartmouth.</p>
      <p>
        I am interested in machine learning, startups, and math. I am currently conducting
        research on the Platonic Representation Hypothesis, exploring whether Western and
        Chinese LLMs converge on the same internal understanding of cultural concepts. I am also
        broadly interested in AI safety, world models, and RL. Outside of the classroom,
        I love playing soccer, the outdoors, reading, drawing, and poker.
      </p>
      <div class="links">
        <a href="mailto:maximilian.b.liu.28@dartmouth.edu">Dartmouth Email</a>
        <a href="mailto:maximilianliu486@gmail.com">Personal Email</a>
        <a href="https://github.com/maxxl28" target="_blank">GitHub</a>
        <a href="https://www.linkedin.com/in/maximilian-liu-24c2/" target="_blank">LinkedIn</a>
      </div>
    </section>

    <!-- EXPERIENCE -->
    <section id="experience">
      <h2>Experience</h2>
      <div class="entries">

        <div class="entry">
          <div class="entry-header">
            <span class="entry-title">Machine Learning Engineer Intern — Booko (YCW26)</span>
            <span class="entry-date">Sep. 2026 – Present</span>
          </div>
          <p>Building revenue-forecasting models to power dynamic pricing.</p>
        </div>

        <div class="entry">
          <div class="entry-header">
            <span class="entry-title">ML Researcher — Dartmouth College</span>
            <span class="entry-date">Jun. 2026 – Present</span>
          </div>
          <p>Advised by Adam Breuer. Analyzing how LLMs internalize cultural values.</p>
        </div>

        <div class="entry">
          <div class="entry-header">
            <span class="entry-title">ML Researcher — Polarization Research Lab</span>
            <span class="entry-date">Jan. 2026 – Present</span>
          </div>
          <p>Advised by Sean Westwood. Detecting LLMs in surveys.</p>
        </div>

        <div class="entry">
          <div class="entry-header">
            <span class="entry-title">Computer Science Teaching Assistant — Dartmouth College</span>
            <span class="entry-date">Sep. 2025 – Mar. 2026</span>
          </div>
          <p>TA for Data Structures & Algorithms.</p>
        </div>

        <div class="entry">
          <div class="entry-header">
            <span class="entry-title">Data Engineering Intern — UC San Diego Center for Epigenomics</span>
            <span class="entry-date">Jun. 2025 – Aug. 2025</span>
          </div>
          <p>Engineered pipeline to process and cluster single-cell transcriptomic profiles.</p>
        </div>

        <div class="entry">
          <div class="entry-header">
            <span class="entry-title">Researcher — Geisel School of Medicine</span>
            <span class="entry-date">Feb. 2025 – Jan. 2026</span>
          </div>
          <p>Built LLM and RAG pipelines to reduce AI therapy hallucinations.</p>
        </div>

      </div>
    </section>

    <!-- PROJECTS -->
    <section id="projects">
      <h2>Projects</h2>
      <div class="entries">

        <div class="entry">
          <div class="entry-header">
            <span class="entry-title">
              <a href="https://github.com/olivia-cong/hackathon" target="_blank">SpotCheck — 1st Place, Dartmouth × Anthropic Hackathon</a>
            </span>
            <span class="entry-date">Nov. 2025</span>
          </div>
          <p>Crowdsourced study space tracker across Dartmouth College.</p>
        </div>

        <div class="entry">
          <div class="entry-header">
            <span class="entry-title">
              <a href="https://github.com/Alejandro-Moro/Predicting_Line_Changes" target="_blank">Kalshi Mean-Reversion Detector</a>
            </span>
            <span class="entry-date">Feb. – Mar. 2026</span>
          </div>
          <p>Detecting mean reversion in political prediction markets.</p>
        </div>

        <div class="entry">
          <div class="entry-header">
            <span class="entry-title">
              <a href="https://github.com/maxxl28/Tiny_Search_Engine" target="_blank">Tiny Search Engine</a>
            </span>
            <span class="entry-date">May – Jun. 2026</span>
          </div>
          <p>C-based web crawler, indexer, and search query engine.</p>
        </div>

        <div class="entry">
          <div class="entry-header">
            <span class="entry-title">
              <a href="https://github.com/maxxl28/breakpoint" target="_blank">Breakpoint</a>
            </span>
            <span class="entry-date">Jan. 2026</span>
          </div>
          <p>Social Debugging for Dartmouth students</p>
        </div>

        <div class="entry">
          <div class="entry-header">
            <span class="entry-title">
              <a href="https://github.com/maxxl28/Premier-League-Fantasy-Analysis" target="_blank">Premier League Fantasy Analysis</a>
            </span>
            <span class="entry-date">Nov. 2025</span>
          </div>
          <p>Linear/logistic regression models predicting Fantasy Premier League player value.</p>
        </div>

      </div>
    </section>

    <!-- BLOG -->
    <section id="blog">
      <h2>Blog</h2>
      <p class="coming-soon">Coming soon.</p>
    </section>

  </div>
</Layout>

<style>
  .page {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 2rem 1.5rem 6rem;
  }

  /* Nav */
  nav {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 5rem;
    font-size: 0.875rem;
  }

  nav a {
    color: var(--muted);
  }

  nav a:hover {
    color: var(--fg);
    text-decoration: none;
  }

  /* Sections */
  section {
    margin-bottom: 5rem;
  }

  h1 {
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  h2 {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1.5rem;
  }

  .coming-soon {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .tagline {
    color: var(--muted);
    margin-bottom: 1rem;
  }

  /* About links */
  .links {
    display: flex;
    gap: 1.25rem;
    margin-top: 1.25rem;
    font-size: 0.875rem;
  }

  .links a {
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .links a:hover {
    color: var(--fg);
  }

  /* Entry list */
  .entries {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .entry-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.3rem;
  }

  .entry-title {
    font-weight: 500;
  }

  .entry-date {
    font-size: 0.8rem;
    color: var(--muted);
    white-space: nowrap;
  }

  .entry p {
    font-size: 0.9rem;
    color: var(--muted);
  }

  .award {
    font-size: 0.8rem;
    color: var(--muted);
    margin-bottom: 0.2rem;
  }

  /* Mobile */
  @media (max-width: 480px) {
    .entry-header {
      flex-direction: column;
      gap: 0.1rem;
    }

    nav {
      gap: 1rem;
    }
  }
</style>
